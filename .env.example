# --- Telegram ---
# Token del bot, te lo da @BotFather al crear el bot con /newbot.
TELEGRAM_BOT_TOKEN=
# chat_id autorizado a dar ordenes al agente (normalmente el tuyo). Ver README para
# como obtenerlo con @userinfobot o el endpoint getUpdates.
TELEGRAM_CHAT_ID=

# --- OpenAI (transcripcion Whisper + interpretacion de la orden) ---
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_NLU_MODEL=gpt-4o-mini

# --- Zoho Mail ---
# Genera estas credenciales en https://api-console.zoho.com (Self Client) con el scope
# ZohoMail.messages.CREATE y ZohoMail.accounts.READ. Ver README para el paso a paso.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Dominio de tu cuenta: zoho.com (global), zoho.eu, zoho.in, etc.
ZOHO_ACCOUNT_DOMAIN=zoho.com
# accountId numerico de tu buzon, se obtiene con GET /api/accounts (ver README)
ZOHO_ACCOUNT_ID=
ZOHO_FROM_ADDRESS=tu-correo@tudominio.com

# --- Notion ---
# Crea una integracion en https://www.notion.so/my-integrations y comparte tus bases
# de datos con ella.
NOTION_API_KEY=

# --- Confirmacion antes de ejecutar acciones (recomendado: true) ---
REQUIRE_CONFIRMATION=true

# --- Rutas de configuracion (contactos y espacios de Notion) ---
CONTACTS_FILE=./config/contacts.json
NOTION_SPACES_FILE=./config/notion-spaces.json
