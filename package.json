{
  "name": "whatsapp-zoho-notion-agent",
  "version": "1.0.0",
  "description": "Agente personal de WhatsApp que transcribe audios y crea correos (Zoho Mail) y tareas de delegacion (Notion).",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@notionhq/client": "^2.2.15",
    "@whiskeysockets/baileys": "^6.7.9",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "openai": "^4.67.3",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^20.16.5",
    "@types/qrcode-terminal": "^0.12.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
